{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "phantom-creative-lab",
  "main": "./worker.js",
  "compatibility_date": "2026-08-26",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [
    { "name": "EMAIL" }
  ],
  "secrets": {
    "required": ["EMAIL_TO", "TURNSTILE_SECRET_KEY"]
  }
}
